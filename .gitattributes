# Validation spectra have byte-level SHA-256 provenance. Preserve their mixed
# line endings exactly on every operating system instead of applying Git's
# platform-specific text conversion.
data/validation/kairis_eis_validation_v1/**/*.csv -text
data/validation/kairis_eis_validation_v1/**/*.txt -text

# Launcher scripts must remain valid after a Windows checkout.
*.sh text eol=lf

# Frozen validation records use byte-stable hashes across operating systems.
paper/VALIDATION_PLAN_v1.md text eol=lf
paper/BLINDED_REVIEW_PROTOCOL_v1.md text eol=lf
paper/DEVIATIONS_LOG_v1.md text eol=lf
paper/PREREGISTRATION_RECORD_v1.md text eol=lf
paper/validation_plan_manifest_v1.json text eol=lf
config/validation_acceptance_v1.json text eol=lf
config/standalone_validation_acceptance_v1.json text eol=lf

# Preserve the downloaded external cohort and generated blind-manifest hashes.
data/external_confirmatory/316l_passivity_osf_xrav8/raw/* -text -whitespace
data/external_confirmatory/316l_passivity_osf_xrav8/prepared_blind/* -text

# Third-party Elsevier CAS sources retain upstream formatting.
paper/manuscript_electrochimica_acta/cas-common.sty -whitespace
paper/manuscript_electrochimica_acta/cas-model2-names.bst -whitespace
paper/manuscript_electrochimica_acta/cas-sc.cls -whitespace
paper/manuscript_electrochimica_acta/elsevier-cas-sc-template-original.tex -whitespace
paper/manuscript_electrochimica_acta/ELSEVIER_TEMPLATE_README.txt -whitespace
paper/manuscript_electrochimica_acta/elsevier-template-manifest.txt -whitespace
